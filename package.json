{
  "name": "the-shorekeeper",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "config": {
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@napi-rs/canvas",
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/copy-vad-assets.mjs && vite",
    "build": "node scripts/copy-vad-assets.mjs && tsc --noEmit && vite build",
    "predist": "node scripts/prepare-dist-assets.mjs",
    "dist": "pnpm build && electron-builder --win",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:health": "tsx scripts/db-health.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:native": "tsx scripts/db-native.ts",
    "db:poc:native": "tsx scripts/native-sqlite-poc.ts",
    "db:cleanup-sessions": "tsx scripts/cleanup-empty-sessions.ts",
    "db:reset-keep-models": "tsx scripts/db-reset-keep-models.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "pnpm build && electron scripts/electron-runtime-smoke.cjs",
    "test:packaged-native": "node scripts/packaged-native-sqlite-smoke.cjs",
    "test:nsis-lifecycle": "node scripts/nsis-install-lifecycle-smoke.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.80",
    "@ricky0123/vad-web": "^0.0.30",
    "better-sqlite3": "13.0.3",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "node-cron": "^4.5.0",
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.0",
    "sql.js": "^1.14.1",
    "uuid": "^11.0.5",
    "word-extractor": "^1.0.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.theshorekeeper.app",
    "productName": "The Shorekeeper",
    "electronDist": "node_modules/electron/dist",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.mjs",
      "skills/**/*",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/semver/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/sax/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/ws/**/*",
      "node_modules/pdf-parse/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/exceljs/**/*",
      "node_modules/archiver/**/*",
      "node_modules/archiver-utils/**/*",
      "node_modules/compress-commons/**/*",
      "node_modules/crc32-stream/**/*",
      "node_modules/fast-csv/**/*",
      "node_modules/@fast-csv/**/*",
      "node_modules/jszip/**/*",
      "node_modules/saxes/**/*",
      "node_modules/unzipper/**/*",
      "node_modules/tmp/**/*",
      "node_modules/dayjs/**/*",
      "node_modules/docx/**/*",
      "node_modules/mammoth/**/*",
      "node_modules/word-extractor/**/*",
      "node_modules/pdf-lib/**/*",
      "node_modules/xml-js/**/*",
      "node_modules/nanoid/**/*",
      "node_modules/hash.js/**/*",
      "node_modules/lop/**/*",
      "node_modules/duck/**/*",
      "node_modules/option/**/*",
      "node_modules/bluebird/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/electron-updater/**",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sql.js/**",
      "**/node_modules/@napi-rs/**",
      "**/dist/*.png",
      "dist/vad/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://theshorekeeper.oss-cn-beijing.aliyuncs.com/shorekeeper/updates/"
      }
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist",
        "to": "sql.js",
        "filter": [
          "sql-wasm.wasm",
          "sql-wasm.js"
        ]
      },
      {
        "from": "src/db/migrations",
        "to": "db-migrations",
        "filter": [
          "*.sql"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
