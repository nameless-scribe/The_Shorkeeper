# 依赖
node_modules/

# 构建产物
dist/
dist-electron/
release/
.vite/

# 环境变量（含 API Key，切勿提交）
.env
.env.local
.env.*.local

# 本地 SQLite（数据库在 D:\SQLlite，此处防误提交）
*.db
*.db-shm
*.db-wal

# 可选：若立绘仅自用不想提交，取消下行注释
# public/keeper-bg.png

# VAD / ONNX 静态资源（由 scripts/copy-vad-assets.mjs 从 node_modules 同步）
public/vad/

# 音频与转写产物（P4）：录音与逐字稿属于敏感内容，绝不入库
*.m4a
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.opus
*.amr
*.silk
*.pcm

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# 编辑器（可选，按需取消注释）
# .vscode/
.idea/

# P8 真实样本图不入库
docs/p8-samples/*.jpg
docs/p8-samples/*.jpeg
docs/p8-samples/*.png
docs/p8-samples/*.webp
docs/p8-samples/*.bmp
docs/p8-samples/*.gif
