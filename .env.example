# 数据库目录（默认 D:\SQLlite）
SHOREKEEPER_DB_DIR=D:\SQLlite
SHOREKEEPER_DB_PATH=D:\SQLlite\shorekeeper.db
SHOREKEEPER_WORKSPACE_DIR=D:\SQLlite\workspace

# ── 阿里云百炼（OpenAI 兼容接口）────────────────────────────
# 推荐在应用内 设置 → API 设置 填写；以下为 .env 默认值（应用内配置优先）

OPENAI_API_KEY=sk-你的百炼APIKey

# 接入点示例（请替换为你控制台里的完整地址，勿使用他人域名）
OPENAI_BASE_URL=https://llm-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 模型 ID（API 用小写 id，不是界面显示名 Qwen3.6-Plus）
DEFAULT_MODEL=qwen3.6-plus

# 可选：百炼部分模型不支持 stream_options，保持 false
INCLUDE_STREAM_USAGE=false

# 显式缓存（cache_control）：默认关闭；需百炼付费且模型支持时再设为 true
ENABLE_EXPLICIT_CACHE=false

# RAG / 记忆向量（可与对话 API 分离；Claude 代理通常需单独配置百炼 Embedding）
# EMBEDDING_API_KEY=sk-你的百炼Key
# EMBEDDING_BASE_URL=https://llm-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# RAG 检索优化（可选）
# RAG_NEIGHBOR_WINDOW=1
# RAG_FTS_FIRST=true
# RAG_DOC_ROUTE_TOP_K=3
# RAG_DOC_ROUTE_MIN_DOCS=4
# RAG_RERANK_ENABLED=false
# RAG_HYDE_ENABLED=false

# ── 性能 / Token 优化（可选，可在设置 → 性能 覆盖）────────────
RAG_ENABLED=true
AUTO_MEMORY_EXTRACT=true
MAX_HISTORY_MESSAGES=20
MEMORY_EXTRACT_INTERVAL=3
COMPRESS_THRESHOLD=30

# 联网搜索（博查 Web Search API，https://open.bochaai.com）
# WEB_SEARCH_API_KEY=sk-你的博查Key
# 也可使用 BOCHA_API_KEY；应用内 设置 → 插件 填写优先于 .env

# ── 语音（CosyVoice TTS，可选）────────────────────────────────
# 默认复用 OPENAI_API_KEY（百炼 DashScope Key）
# VOICE_API_KEY=sk-你的百炼Key
# DASHSCOPE_API_KEY=sk-你的百炼Key
# 若 Chat 使用业务空间 URL，TTS 会自动推导；也可手动指定：
# VOICE_TTS_ENDPOINT=https://llm-xxxx.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# ── 录音转写（腾讯云 录音文件识别极速版，P4）─────────────────
# 与对话模型是两套独立凭证：对话走百炼，转写走腾讯云。
# 建议使用【子账号】密钥并只授予语音识别权限；SecretKey 只在创建时显示一次。
# AppID 是纯数字，在控制台「账号信息」页查看——注意别和同为数字的“账号ID”混淆。
# TENCENT_ASR_SECRET_ID=AKID你的SecretId
# TENCENT_ASR_SECRET_KEY=你的SecretKey
# TENCENT_ASR_APP_ID=1259220000
# 也可在 设置 → 语音 粘贴百炼复刻 voice_id

# ── 主动提醒与主动收件箱（应用内 设置 → 记忆 → 主动提醒 / 主动收件箱 优先）──
# 以下均为可选；未设置时使用默认值。
# PROACTIVITY_ENABLED=true                # 全局开关；false 时不弹窗、不生成新提示、后台不主动发起 Agent 运行
# PROACTIVITY_QUIET_START=22:00           # 安静时段开始（HH:mm，留空不启用）
# PROACTIVITY_QUIET_END=07:00             # 安静时段结束，支持跨午夜
# PROACTIVITY_DEDUP_MINUTES=5             # 同一提醒重复弹窗抑制窗口（0 关闭）
# PROACTIVITY_NOTIFY_HOURLY_LIMIT=3       # 本地事件每小时即时弹窗上限（0 不限制）；达到后只进收件箱
# PROACTIVITY_NOTIFY_DAILY_LIMIT=12       # 本地事件每日即时弹窗上限（0 不限制）
# PROACTIVITY_MUTED_DOMAINS=["document"]  # JSON 数组：静音的事件域 task/commitment/run/schedule/document/memory/goal
# PROACTIVITY_KEEP_INBOX_HISTORY=true     # 关闭主动提醒后是否保留收件箱历史；false 时关闭即清空

# ── 看图（视觉模型，P8）：应用内 设置 → 语音 → 看图 优先 ────────────────
# VISION_ENABLED=false            # 允许把图片发送到视觉模型，默认关
# VISION_MODEL=qwen3-vl-plus      # 便宜档 qwen3-vl-flash
# VISION_BASE_URL=                # 留空复用 OPENAI_BASE_URL
# VISION_API_KEY=                 # 留空复用 OPENAI_API_KEY
# VISION_MAX_PIXELS=16000000
